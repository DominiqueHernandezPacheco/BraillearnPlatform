# Copia este archivo a ".env" (en la raíz del proyecto) y rellena los valores.
# .env NUNCA se sube a git (ver .gitignore).

# AccessKey de tu cuenta en https://console.picovoice.ai/ (gratis)
PICOVOICE_ACCESS_KEY=

# API key de la API de Anthropic (console.anthropic.com) — se usa para las
# preguntas abiertas del asistente de voz "Braulio" (Fase 2).
ANTHROPIC_API_KEY=

# API key de ElevenLabs (elevenlabs.io > perfil > API Keys) — voz natural de Braulio.
ELEVENLABS_API_KEY=

# Id de la voz elegida (ver `npm run tts:audition`). Opcionales: TTS_PROVIDER=piper para
# forzar la voz local, ELEVENLABS_MONTHLY_BUDGET=9000 (caracteres/mes que se permite gastar).
ELEVENLABS_VOICE_ID=
